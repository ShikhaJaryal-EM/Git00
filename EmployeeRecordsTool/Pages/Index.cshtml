@page
@model IndexModel
@{
    ViewData["Title"] = "Employee list";
}

<h1 class="h3">Employee Records Tool</h1>

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger">@Model.ErrorMessage</div>
}

<p>
    <a class="btn btn-primary" asp-page="/Create">Create employee</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>First name</th>
            <th>Last name</th>
            <th>Status</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
    @foreach (var employee in Model.Employees)
    {
        <tr>
            <td>@employee.FirstName</td>
            <td>@employee.LastName</td>
            <td>@employee.Status</td>
            <td>
                <a class="btn btn-secondary" asp-page="/Edit" asp-route-id="@employee.Id">Edit</a>
                @if (employee.Status == EmployeeStatus.Active)
                {
                    <form method="post" asp-page-handler="Deactivate" class="d-inline">
                        <input type="hidden" name="id" value="@employee.Id" />
                        <button type="submit" class="btn btn-secondary">Deactivate</button>
                    </form>
                }
                @if (employee.Status == EmployeeStatus.Inactive)
                {
                    <form method="post" asp-page-handler="Reactivate" class="d-inline">
                        <input type="hidden" name="id" value="@employee.Id" />
                        <button type="submit" class="btn btn-secondary">Reactivate</button>
                    </form>
                }
            </td>
        </tr>
    }
    </tbody>
</table>
